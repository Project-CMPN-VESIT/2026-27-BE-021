# ==============================================================================
# Vision-Learn AI — Comprehensive .gitignore
# ==============================================================================

# ── 1. Environment Variables & Secrets (CRITICAL) ─────────────────────────────
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
# Ensure template/example env files are explicitly tracked:
!.env.example
!frontend/.env.example
!pipeline/.env.example

# Credentials, Keys & Certificates
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
credentials.json
client_secret*.json
service-account*.json

# ── 2. Pipeline Artifacts & Media Processing ──────────────────────────────────
# Storage directory holds runtime generated data (video, audio, frames, narrations)
storage/
uploads/
temp/
tmp/
_tts_tmp/
temp_notes/
.cache/

# yt-dlp & ffmpeg partial download files
*.part
*.ytdl
*.ytdl-*.part

# ── 3. Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.pyo

# Distribution / Packaging
dist/
build/
eggs/
.eggs/
*.egg
*.egg-info/
*.manifest
*.spec
develop-eggs/
downloads/
pip-wheel-metadata/

# Jupyter Notebooks
.ipynb_checkpoints/

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Linting
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
htmlcov/
.coverage
.coverage.*
*.cover
coverage.xml

# ── 4. Node.js & Frontend (Next.js / React) ───────────────────────────────────
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
build/
.turbo/
.vercel/

# TypeScript & Next build info
*.tsbuildinfo
next-env.d.ts

# Package manager debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.pnp/
.pnp.*

# ── 5. Databases & Local State ────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
dump.rdb

# ── 6. Logs ───────────────────────────────────────────────────────────────────
*.log
logs/

# ── 7. IDEs & Editors ─────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.#*
.project
.settings/
*.sublime-project
*.sublime-workspace
*.iml
*.iws
*.ipr

# ── 8. Operating System Specific ──────────────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
desktop.ini
ehthumbs.db
ehthumbs_vista.db
$RECYCLE.BIN/
